---
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
---

<PageLayout title="搜尋" description="搜尋 21dev.org 的所有比特幣技術文章、教學和文檔。">
  <section
    class="py-16 md:py-24 bg-gradient-to-b from-[var(--bg-secondary)] to-[var(--bg-primary)]"
  >
    <div class="container-wide">
      <Breadcrumb items={[{ label: '搜尋' }]} />
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold text-[var(--text-primary)] mb-6">搜尋</h1>
        <p class="text-xl text-[var(--text-secondary)]">
          搜尋所有比特幣技術文章、BIP 提案、教學內容和術語。
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-wide max-w-3xl mx-auto">
      <!-- Search input -->
      <div class="relative">
        <svg
          class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-[var(--text-tertiary)]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="search"
          id="page-search-input"
          placeholder="輸入關鍵字搜尋..."
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          class="w-full px-4 py-4 pl-12 rounded-xl bg-[var(--surface-elevated)] border border-[var(--border-default)] text-[var(--text-primary)] text-lg font-medium placeholder-[var(--text-tertiary)] focus:outline-none focus:ring-2 focus:ring-bitcoin-500/50 focus:border-bitcoin-500"
        />
      </div>

      <!-- Search status -->
      <div id="search-status" class="mt-4 text-sm text-[var(--text-tertiary)] hidden"></div>

      <!-- Results container -->
      <div id="page-search-results" class="mt-8">
        <!-- Initial state -->
        <div id="page-initial" class="py-16 text-center text-[var(--text-tertiary)]">
          <svg
            class="h-16 w-16 mx-auto mb-4 opacity-30"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <p class="text-lg">輸入關鍵字開始搜尋</p>
          <p class="text-sm mt-2">支援搜尋文章標題、內容和術語</p>
        </div>

        <!-- Loading state -->
        <div id="page-loading" class="hidden py-16 text-center text-[var(--text-tertiary)]">
          <div
            class="inline-block w-8 h-8 border-2 border-[var(--border-default)] border-t-bitcoin-500 rounded-full animate-spin"
          >
          </div>
          <p class="mt-4">搜尋中...</p>
        </div>

        <!-- No results -->
        <div id="page-empty" class="hidden py-16 text-center text-[var(--text-tertiary)]">
          <svg
            class="h-16 w-16 mx-auto mb-4 opacity-30"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          <p class="text-lg">找不到相關結果</p>
          <p class="text-sm mt-2">試試其他關鍵字，或瀏覽下方熱門頁面</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a
              href="/learn/basics/"
              class="px-4 py-2 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border-default)] text-sm text-[var(--text-secondary)] hover:text-bitcoin-500 hover:border-bitcoin-500/50 transition-colors"
            >
              學習入門
            </a>
            <a
              href="/bips/"
              class="px-4 py-2 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border-default)] text-sm text-[var(--text-secondary)] hover:text-bitcoin-500 hover:border-bitcoin-500/50 transition-colors"
            >
              BIP 文檔
            </a>
            <a
              href="/glossary/"
              class="px-4 py-2 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border-default)] text-sm text-[var(--text-secondary)] hover:text-bitcoin-500 hover:border-bitcoin-500/50 transition-colors"
            >
              術語詞典
            </a>
            <a
              href="/tech/"
              class="px-4 py-2 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border-default)] text-sm text-[var(--text-secondary)] hover:text-bitcoin-500 hover:border-bitcoin-500/50 transition-colors"
            >
              技術文檔
            </a>
          </div>
        </div>

        <!-- Results list -->
        <div id="page-list" class="hidden space-y-4"></div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  interface PagefindResult {
    url: string;
    excerpt: string;
    meta: {
      title?: string;
      image?: string;
    };
  }

  interface PagefindSearchResult {
    data: () => Promise<PagefindResult>;
  }

  interface PagefindSearch {
    results: PagefindSearchResult[];
  }

  interface Pagefind {
    init: () => Promise<void>;
    search: (query: string) => Promise<PagefindSearch>;
  }

  let pagefind: Pagefind | null = null;

  async function loadPagefind(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    try {
      const pagefindPath = '/pagefind/pagefind.js';
      const pf = (await import(/* @vite-ignore */ pagefindPath)) as Pagefind;
      await pf.init();
      pagefind = pf;
      return pagefind;
    } catch (e) {
      console.error('Failed to load Pagefind:', e);
      return null;
    }
  }

  const categoryMap: Record<string, { label: string; color: string }> = {
    bips: { label: 'BIP 提案', color: '#3B82F6' },
    'tech/bitcoin-core': { label: 'Bitcoin Core', color: '#F7931A' },
    'tech/lightning': { label: '閃電網路', color: '#FACC15' },
    'tech/nostr': { label: 'Nostr', color: '#8B5CF6' },
    'learn/basics': { label: '入門基礎', color: '#22C55E' },
    'learn/intermediate': { label: '進階知識', color: '#3B82F6' },
    'learn/advanced': { label: '高級技術', color: '#EF4444' },
    'learn/lightning': { label: '閃電網路學習', color: '#FACC15' },
    books: { label: '推薦書籍', color: '#EC4899' },
    'notable-figures': { label: '重要人物', color: '#F7931A' },
    glossary: { label: '術語詞典', color: '#14B8A6' },
    blog: { label: '文章', color: '#6366F1' },
  };

  function getCategoryFromUrl(url: string): { label: string; color: string } | null {
    for (const [path, category] of Object.entries(categoryMap)) {
      if (url.includes('/' + path + '/') || url.includes('/' + path)) {
        return category;
      }
    }
    return null;
  }

  function initPageSearch() {
    const input = document.getElementById('page-search-input') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const initial = document.getElementById('page-initial');
    const loading = document.getElementById('page-loading');
    const empty = document.getElementById('page-empty');
    const list = document.getElementById('page-list');

    if (!input || !status || !initial || !loading || !empty || !list) return;

    let debounceTimer: ReturnType<typeof setTimeout>;

    function showState(state: 'initial' | 'loading' | 'empty' | 'results') {
      initial!.classList.toggle('hidden', state !== 'initial');
      loading!.classList.toggle('hidden', state !== 'loading');
      empty!.classList.toggle('hidden', state !== 'empty');
      list!.classList.toggle('hidden', state !== 'results');
      status!.classList.toggle('hidden', state !== 'results');
    }

    async function performSearch(query: string) {
      if (!query.trim()) {
        showState('initial');
        updateUrl('');
        return;
      }

      showState('loading');
      updateUrl(query);

      const pf = await loadPagefind();
      if (!pf) {
        showState('empty');
        return;
      }

      const search = await pf.search(query);
      if (search.results.length === 0) {
        showState('empty');
        return;
      }

      const resultsData = await Promise.all(
        search.results.slice(0, 30).map((r: PagefindSearchResult) => r.data())
      );

      status!.textContent = `找到 ${search.results.length} 筆結果`;
      status!.classList.remove('hidden');

      let html = '';
      for (const result of resultsData) {
        const category = getCategoryFromUrl(result.url);
        const categoryBadge = category
          ? `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium" style="background-color: ${category.color}20; color: ${category.color}">${category.label}</span>`
          : '';

        html += `
          <a href="${result.url}" class="block p-5 rounded-xl bg-[var(--surface-elevated)] border border-[var(--border-default)] hover:border-bitcoin-500/50 hover:shadow-md transition-all">
            <div class="flex items-start gap-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  ${categoryBadge}
                </div>
                <h3 class="font-semibold text-[var(--text-primary)] text-lg">${result.meta?.title || 'Untitled'}</h3>
                <p class="text-sm text-[var(--text-secondary)] mt-2 line-clamp-2">${result.excerpt}</p>
                <span class="text-xs text-[var(--text-tertiary)] mt-2 block">${result.url}</span>
              </div>
              <svg class="h-5 w-5 text-[var(--text-tertiary)] flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        `;
      }

      list!.innerHTML = html;
      showState('results');
    }

    function updateUrl(query: string) {
      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set('q', query);
      } else {
        url.searchParams.delete('q');
      }
      history.replaceState(null, '', url.toString());
    }

    // Read initial query from URL
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';
    if (initialQuery) {
      input.value = initialQuery;
      performSearch(initialQuery);
    }

    // Search on input with debounce
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(input.value);
      }, 300);
    });

    // Focus input on page load
    input.focus();
  }

  document.addEventListener('DOMContentLoaded', initPageSearch);
  document.addEventListener('astro:page-load', initPageSearch);
</script>

<style is:global>
  #page-list mark {
    background-color: rgba(247, 147, 26, 0.3);
    color: inherit;
    border-radius: 2px;
    padding: 0 2px;
  }

  #page-list .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
