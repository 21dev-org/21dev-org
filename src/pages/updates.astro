---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Tag from '@/components/ui/Tag.astro';
import { difficultyLabels, difficultyVariants, type Difficulty } from '@/data/constants';

// Gather all dated content
const articles = await getCollection('articles');
const events = await getCollection('events');
const glossary = await getCollection('glossary');
const videos = await getCollection('videos');

interface UpdateItem {
  title: string;
  href: string;
  date: Date;
  type: 'article' | 'event' | 'glossary' | 'video';
  description?: string;
  difficulty?: string;
}

const updates: UpdateItem[] = [
  ...articles.map((a) => ({
    title: a.data.title,
    href: `/blog/${a.slug}`,
    date: new Date(a.data.date),
    type: 'article' as const,
    description: a.data.description,
    difficulty: a.data.difficulty,
  })),
  ...events.map((e) => ({
    title: e.data.title,
    href: `/events/${e.slug}`,
    date: new Date(e.data.date),
    type: 'event' as const,
    description: e.data.description,
  })),
  ...glossary.map((g) => ({
    title: `${g.data.term} (${g.data.termEn})`,
    href: `/glossary/${g.slug}`,
    date: new Date(),
    type: 'glossary' as const,
    description: g.data.short,
  })),
  ...videos.map((v) => ({
    title: v.data.title,
    href: `/videos/${v.slug}`,
    date: new Date(v.data.date),
    type: 'video' as const,
    description: v.data.description,
  })),
];

// Sort by date (newest first) and take top 50
const sortedUpdates = updates.sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 50);

// Group by month
const updatesByMonth = new Map<string, UpdateItem[]>();
for (const item of sortedUpdates) {
  const key = item.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long' });
  if (!updatesByMonth.has(key)) {
    updatesByMonth.set(key, []);
  }
  updatesByMonth.get(key)!.push(item);
}

const typeLabels: Record<string, { label: string; color: string }> = {
  article: { label: '文章', color: 'bitcoin' },
  event: { label: '活動', color: 'lightning' },
  glossary: { label: '術語', color: 'nostr' },
  video: { label: '影片', color: 'success' },
};
---

<PageLayout title="最近更新" description="21dev.org 最近新增和更新的內容一覽。">
  <section
    class="py-16 md:py-24 bg-gradient-to-b from-[var(--bg-secondary)] to-[var(--bg-primary)]"
  >
    <div class="container-wide">
      <Breadcrumb items={[{ label: '最近更新' }]} />
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold text-[var(--text-primary)] mb-6">最近更新</h1>
        <p class="text-xl text-[var(--text-secondary)]">網站最近新增和更新的內容。</p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="container-wide max-w-3xl mx-auto">
      {
        [...updatesByMonth.entries()].map(([month, items]) => (
          <div class="mb-12">
            <h2 class="text-sm font-semibold text-[var(--text-tertiary)] uppercase tracking-wider mb-6 sticky top-20 bg-[var(--bg-primary)] py-2 z-10">
              {month}
            </h2>
            <div class="space-y-4">
              {items.map((item) => {
                const typeInfo = typeLabels[item.type];
                return (
                  <a
                    href={item.href}
                    class="block p-5 rounded-xl bg-[var(--surface-elevated)] border border-[var(--border-default)] hover:border-bitcoin-500/50 hover:shadow-md transition-all group"
                  >
                    <div class="flex items-start justify-between gap-4">
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-2">
                          <Tag
                            size="sm"
                            variant={
                              typeInfo.color as 'bitcoin' | 'lightning' | 'nostr' | 'success'
                            }
                          >
                            {typeInfo.label}
                          </Tag>
                          {item.difficulty && (
                            <Tag
                              size="sm"
                              variant={difficultyVariants[item.difficulty as Difficulty]}
                            >
                              {difficultyLabels[item.difficulty as Difficulty]}
                            </Tag>
                          )}
                        </div>
                        <h3 class="font-semibold text-[var(--text-primary)] group-hover:text-bitcoin-500 transition-colors">
                          {item.title}
                        </h3>
                        {item.description && (
                          <p class="text-sm text-[var(--text-secondary)] mt-1 line-clamp-2">
                            {item.description}
                          </p>
                        )}
                      </div>
                      <time class="text-xs text-[var(--text-tertiary)] whitespace-nowrap flex-shrink-0">
                        {item.date.toLocaleDateString('zh-TW', {
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }

      {
        sortedUpdates.length === 0 && (
          <div class="text-center py-12 border border-dashed border-[var(--border-default)] rounded-xl">
            <p class="text-[var(--text-secondary)]">暫無更新記錄。</p>
          </div>
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
