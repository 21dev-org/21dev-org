---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Tag from '@/components/ui/Tag.astro';
import { difficultyLabels, difficultyVariants, type Difficulty } from '@/data/constants';

const allArticles = await getCollection('articles');

// Sort by date (newest first)
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Group by year
const articlesByYear = new Map<number, typeof sortedArticles>();
for (const article of sortedArticles) {
  const year = new Date(article.data.date).getFullYear();
  if (!articlesByYear.has(year)) {
    articlesByYear.set(year, []);
  }
  articlesByYear.get(year)!.push(article);
}
---

<PageLayout
  title="文章"
  description="比特幣技術文章、教學和深度分析。涵蓋 Bitcoin Core、閃電網路、Taproot 等技術主題。"
>
  <section
    class="py-16 md:py-24 bg-gradient-to-b from-[var(--bg-secondary)] to-[var(--bg-primary)]"
  >
    <div class="container-wide">
      <Breadcrumb items={[{ label: '文章' }]} />
      <div class="max-w-3xl flex items-start justify-between">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--text-primary)] mb-6">文章</h1>
          <p class="text-xl text-[var(--text-secondary)]">比特幣技術文章、教學和深度分析。</p>
        </div>
        <a
          href="/rss.xml"
          class="flex items-center gap-2 px-3 py-2 rounded-lg border border-[var(--border-default)] text-sm text-[var(--text-secondary)] hover:text-bitcoin-500 hover:border-bitcoin-500/50 transition-colors flex-shrink-0 mt-2"
          title="RSS Feed"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"
            ></path>
          </svg>
          RSS
        </a>
      </div>
    </div>
  </section>

  {
    sortedArticles.length === 0 ? (
      <section class="py-16 md:py-24">
        <div class="container-wide">
          <div class="text-center py-12 border border-dashed border-[var(--border-default)] rounded-xl">
            <svg
              class="h-12 w-12 mx-auto text-[var(--text-tertiary)] mb-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
              />
            </svg>
            <p class="text-[var(--text-secondary)]">尚未發布文章，敬請期待。</p>
          </div>
        </div>
      </section>
    ) : (
      <section class="py-16 md:py-24">
        <div class="container-wide max-w-3xl mx-auto">
          {[...articlesByYear.entries()].map(([year, articles]) => (
            <div class="mb-12">
              <h2 class="text-sm font-semibold text-[var(--text-tertiary)] uppercase tracking-wider mb-6">
                {year}
              </h2>
              <div class="space-y-6">
                {articles.map((article) => (
                  <a
                    href={`/blog/${article.slug}`}
                    class="block p-6 rounded-xl bg-[var(--surface-elevated)] border border-[var(--border-default)] hover:border-bitcoin-500/50 hover:shadow-md transition-all group"
                  >
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                      {article.data.difficulty && (
                        <Tag
                          size="sm"
                          variant={difficultyVariants[article.data.difficulty as Difficulty]}
                        >
                          {difficultyLabels[article.data.difficulty as Difficulty]}
                        </Tag>
                      )}
                      {article.data.tags?.slice(0, 3).map((tag: string) => (
                        <Tag size="sm">{tag}</Tag>
                      ))}
                    </div>
                    <h3 class="text-xl font-bold text-[var(--text-primary)] group-hover:text-bitcoin-500 transition-colors">
                      {article.data.title}
                    </h3>
                    <p class="text-[var(--text-secondary)] mt-2 line-clamp-2">
                      {article.data.description}
                    </p>
                    <div class="flex items-center gap-4 mt-4 text-sm text-[var(--text-tertiary)]">
                      <span>
                        {new Date(article.data.date).toLocaleDateString('zh-TW', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </span>
                      {article.data.readingTime && <span>{article.data.readingTime} 分鐘閱讀</span>}
                      {article.data.author && <span>{article.data.author}</span>}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }
</PageLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
