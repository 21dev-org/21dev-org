---
import { getCollection } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import type { Difficulty } from '@/data/constants';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  // Sort for prev/next navigation
  const sorted = articles.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return sorted.map((article, index) => ({
    params: { slug: article.slug },
    props: {
      article,
      prevArticle: sorted[index + 1] || null,
      nextArticle: sorted[index - 1] || null,
    },
  }));
}

const { article, prevArticle, nextArticle } = Astro.props;
const { Content } = await article.render();
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  breadcrumbs={[{ label: '文章', href: '/blog/' }, { label: article.data.title }]}
  tags={article.data.tags}
  difficulty={article.data.difficulty as Difficulty | undefined}
  readingTime={article.data.readingTime ? `${article.data.readingTime} 分鐘` : undefined}
  author={article.data.author}
  date={article.data.date}
  prevPage={prevArticle
    ? { title: prevArticle.data.title, href: `/blog/${prevArticle.slug}` }
    : undefined}
  nextPage={nextArticle
    ? { title: nextArticle.data.title, href: `/blog/${nextArticle.slug}` }
    : undefined}
>
  <Content />
</ArticleLayout>
